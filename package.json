{
	"name": "n8n-nodes-apipj",
	"version": "0.1.0",
	"description": "Consultar CNPJ no n8n com a API CNPJ gratuita do apipj: razão social, situação cadastral, endereço, CNAE, sócios e Simples Nacional direto da base da Receita Federal. Valida CNPJ numérico e alfanumérico. Funciona como ferramenta de AI Agent.",
	"license": "MIT",
	"homepage": "https://apipj.com.br",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-nodes",
		"cnpj",
		"api cnpj",
		"api cnpj gratuita",
		"consultar cnpj",
		"consulta cnpj",
		"receita federal",
		"validar cnpj",
		"cnpj alfanumerico",
		"apipj",
		"brasil"
	],
	"author": {
		"name": "apipj",
		"email": "contato@apipj.com.br",
		"url": "https://apipj.com.br"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/apipj/n8n-nodes-apipj.git"
	},
	"bugs": {
		"url": "https://github.com/apipj/n8n-nodes-apipj/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "node --test test/execute.test.mjs"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ApipjApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Apipj/Apipj.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.52.2",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
