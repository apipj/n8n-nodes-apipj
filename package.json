{
  "name": "n8n-nodes-apipj",
  "version": "0.1.1",
  "description": "API CNPJ gratuita no n8n: consultar CNPJ na Receita Federal, validar CNPJ e CNPJ alfanumérico. Brazilian CNPJ company lookup node (free API).",
  "license": "MIT",
  "homepage": "https://apipj.com.br",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-nodes",
    "cnpj",
    "api cnpj",
    "api cnpj gratuita",
    "consultar cnpj",
    "consulta cnpj",
    "receita federal",
    "validar cnpj",
    "cnpj alfanumerico",
    "apipj",
    "brasil",
    "brazil",
    "company lookup",
    "cnpj lookup"
  ],
  "author": {
    "name": "MASTER BI TECNOLOGIA LTDA",
    "email": "brunogalizzi@masterbi.com",
    "url": "https://apipj.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apipj/n8n-nodes-apipj.git"
  },
  "bugs": {
    "url": "https://github.com/apipj/n8n-nodes-apipj/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test test/execute.test.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ApipjApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Apipj/Apipj.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.52.2",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
